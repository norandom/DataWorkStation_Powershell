$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: Go programming language
    type: Microsoft.WinGet/Package
    properties:
      id: GoLang.Go
      source: winget
      useLatest: true
