$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: Microsoft OpenJDK 21 LTS
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.OpenJDK.21
      source: winget
      useLatest: true
