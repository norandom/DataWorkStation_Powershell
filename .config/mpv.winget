$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: MPV official Windows CI build
    type: Microsoft.WinGet/Package
    properties:
      id: mpv-player.mpv-CI.MSVC
      source: winget
      useLatest: true
