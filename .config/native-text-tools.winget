$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - name: Native Win32 BusyBox applet host
    type: Microsoft.WinGet/Package
    properties:
      id: frippery.busybox-w32
      source: winget
      useLatest: true
