# Copy to .wsl-env and select each managed WSL distribution and its normal user.
WSL_DISTRIBUTION=Debian
WSL_USER=your-linux-user
WSL_MALWARE_DISTRIBUTION=Debian-MW
WSL_MALWARE_USER=your-linux-user
WSL_NIXOS_DISTRIBUTION=NixOS
WSL_NIXOS_USER=your-linux-user
WSL_AI_DISTRIBUTION=NixOS-AI
WSL_AI_USER=ai
