// Merge these entries into the existing Tailscale policy.
// Do not replace existing nodeAttrs or grants.
// Members may use Taildrive on their devices.
"nodeAttrs": [
  {
    "target": ["autogroup:member"],
    "attr": ["drive:share", "drive:access"],
  },
],

// A member may read and write shares only on their own devices.
"grants": [
  {
    "src": ["autogroup:member"],
    "dst": ["autogroup:self"],
    "app": {
      "tailscale.com/cap/drive": [
        {
          "shares": ["*"],
          "access": "rw",
        },
      ],
    },
  },
],
