{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataworkstation.local/schemas/ewf-verification-plan-1.0.json",
  "title": "EWF verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "status",
    "selectedPath",
    "reportDestination",
    "toolRecord",
    "segmentCandidates",
    "operations",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "action": { "const": "Plan" },
    "status": { "const": "planned" },
    "selectedPath": { "type": "string" },
    "reportDestination": { "type": "string" },
    "toolRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "upstreamVersion", "buildRevision", "reviewState"],
      "properties": {
        "toolId": { "const": "ewfverify" },
        "upstreamVersion": { "type": "string" },
        "buildRevision": { "type": "string", "pattern": "^b[1-9][0-9]*$" },
        "reviewState": { "enum": ["Candidate", "Approved", "Withdrawn", "Superseded"] }
      }
    },
    "segmentCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "path"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1 },
          "path": { "type": "string" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "readsMediaData", "changesSystemState"],
        "properties": {
          "name": { "type": "string" },
          "readsMediaData": { "const": false },
          "changesSystemState": { "const": false }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
